{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/benchmark_material_plan.schema.json",
  "title": "MetaWingman immutable benchmark material plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "pack_id", "candidate_ids", "review_family_id",
    "supported_scopes", "reproduction_ceiling", "status", "historical_boundaries",
    "license_assessment", "artifacts", "blockers"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "pack_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "candidate_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
    },
    "review_family_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "supported_scopes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["screening", "lineage", "extraction", "appraisal", "analysis", "living_update", "ipd_workflow"]}
    },
    "reproduction_ceiling": {
      "enum": ["method_code_only", "analysis_only", "extraction_to_analysis", "screening_to_analysis", "living_update", "controlled_ipd_workflow"]
    },
    "status": {"enum": ["development_ready", "reference_only", "blocked", "hold"]},
    "historical_boundaries": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "value", "precision", "source_note"],
        "properties": {
          "kind": {"enum": ["search_cutoff", "update_cutoff", "data_access_cutoff"]},
          "value": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2})?(-[0-9]{2})?$"},
          "precision": {"enum": ["day", "month", "year"]},
          "source_note": {"type": "string", "minLength": 1}
        }
      }
    },
    "license_assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["pack_redistributable", "reviewed_at_utc", "notes"],
      "properties": {
        "pack_redistributable": {"type": "boolean"},
        "reviewed_at_utc": {"type": "string", "format": "date-time"},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "artifact_id", "role", "artifact_type", "source_url", "immutable_revision",
          "destination", "expected_sha256", "expected_bytes", "license",
          "temporal_relation", "contains_answer", "retrieval_policy", "notes"
        ],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "role": {"enum": ["operational_input", "documentation", "sealed_reference", "sealed_post_cutoff"]},
          "artifact_type": {"enum": ["readme", "license", "protocol", "analysis_code", "model_code", "search_export", "screening_reference", "extraction_reference", "analysis_input", "analysis_output", "other"]},
          "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "immutable_revision": {"type": "string", "minLength": 1},
          "destination": {"type": "string", "pattern": "^[A-Za-z0-9._/ -]+$", "minLength": 1},
          "expected_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "expected_bytes": {"type": "integer", "minimum": 1},
          "license": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "identifier", "redistributable", "evidence_url"],
            "properties": {
              "status": {"enum": ["verified_open", "repository_review_required", "controlled_terms", "article_terms"]},
              "identifier": {"type": "string", "minLength": 1},
              "redistributable": {"type": "boolean"},
              "evidence_url": {"type": "string", "format": "uri"}
            }
          },
          "temporal_relation": {"enum": ["at_or_before_cutoff", "post_cutoff", "not_time_bound", "unresolved"]},
          "contains_answer": {"type": "boolean"},
          "retrieval_policy": {"enum": ["fetch_by_default", "requires_run_lock", "metadata_only", "blocked"]},
          "notes": {"type": "string"}
        }
      }
    },
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
