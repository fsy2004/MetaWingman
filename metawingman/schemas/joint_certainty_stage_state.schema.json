{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/joint_certainty_stage_state.schema.json",
  "title": "Conservative evaluation certainty and claims state",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema_version", "stage_id", "case_id", "arm_id", "seed", "synthesis_state_artifact",
    "certainty_assessment", "claims", "production_human_responsibility_pending",
    "published_reference_accessed"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "stage_id": {"const": "certainty_interpretation"},
    "case_id": {"type": "string", "minLength": 1},
    "arm_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "synthesis_state_artifact": {"$ref": "#/$defs/fileBinding"},
    "certainty_assessment": {"type": "object"},
    "claims": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "production_human_responsibility_pending": {"const": true},
    "published_reference_accessed": {"const": false}
  },
  "$defs": {
    "fileBinding": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
