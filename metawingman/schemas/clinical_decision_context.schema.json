{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/clinical_decision_context.schema.json",
  "title": "MetaWingman clinical decision context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "context_id", "stakeholders", "setting", "decision_problem", "candidate_actions", "time_horizon", "patient_important_outcomes", "subgroups", "equity_factors", "implementation_constraints", "source_anchors", "status", "created_at_utc"],
  "$defs": {
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["anchor_id", "field", "verbatim", "source_type"],
      "properties": {
        "anchor_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "field": {"type": "string", "minLength": 1},
        "verbatim": {"type": "string", "minLength": 1},
        "source_type": {"enum": ["user_input", "protocol", "verified_source"]}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "context_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "stakeholders": {"$ref": "#/$defs/strings"},
    "setting": {"$ref": "#/$defs/strings"},
    "decision_problem": {"type": "string"},
    "candidate_actions": {"$ref": "#/$defs/strings"},
    "time_horizon": {"type": "string"},
    "patient_important_outcomes": {"$ref": "#/$defs/strings"},
    "subgroups": {"$ref": "#/$defs/strings"},
    "equity_factors": {"$ref": "#/$defs/strings"},
    "implementation_constraints": {"$ref": "#/$defs/strings"},
    "source_anchors": {"type": "array", "items": {"$ref": "#/$defs/anchor"}},
    "status": {"enum": ["complete", "incomplete", "abstained"]},
    "created_at_utc": {"type": "string", "format": "date-time"}
  }
}
