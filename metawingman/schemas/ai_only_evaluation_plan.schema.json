{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/ai_only_evaluation_plan.schema.json",
  "title": "MetaWingman AI-only repeated-run evaluation plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_id", "plan_version", "status", "benchmark_version",
    "design", "target_tasks", "configurations", "repetitions_per_case", "reference_standard",
    "metrics", "critical_error_weights", "release_thresholds", "inference_limits",
    "frozen_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "plan_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "frozen", "retired"]},
    "benchmark_version": {"type": "string", "minLength": 1},
    "design": {"const": "ai_only_repeated_runs"},
    "target_tasks": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["search", "screening", "lineage", "extraction", "appraisal_dossier", "poolability_dossier", "analysis", "claim_compilation", "end_to_end"]}
    },
    "configurations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "configuration_id", "description", "model_registry_refs", "pipeline_version",
          "prompt_sha256", "tool_versions", "ablations", "max_model_calls", "retry_budget"
        ],
        "properties": {
          "configuration_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "description": {"type": "string", "minLength": 1},
          "model_registry_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "pipeline_version": {"type": "string", "minLength": 1},
          "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "tool_versions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "ablations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "max_model_calls": {"type": "integer", "minimum": 1},
          "retry_budget": {"type": "integer", "minimum": 0}
        }
      }
    },
    "repetitions_per_case": {"type": "integer", "minimum": 2},
    "reference_standard": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "correction_policy", "integrity_policy", "de_novo_human_adjudication", "answers_sealed_until_all_runs_locked"],
      "properties": {
        "source": {"const": "published_expert_reference"},
        "correction_policy": {"const": "verified_corrected_version_only"},
        "integrity_policy": {"const": "unresolved_cases_excluded_from_held_out_scoring"},
        "de_novo_human_adjudication": {"const": false},
        "answers_sealed_until_all_runs_locked": {"const": true}
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["primary", "secondary", "aggregation_unit", "uncertainty_method"],
      "properties": {
        "primary": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["critical_error_rate", "false_exclusion_rate", "unsupported_value_rate", "end_to_end_result_accuracy"]}
        },
        "secondary": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["coverage", "abstention_rate", "precision", "recall", "f1", "numerical_equivalence", "run_to_run_reliability", "position_sensitivity", "judge_order_sensitivity", "wall_clock_seconds", "model_calls", "input_tokens", "output_tokens", "api_cost", "compute_cost"]}
        },
        "aggregation_unit": {"const": "review_family"},
        "uncertainty_method": {"const": "paired_bootstrap_by_review_family"}
      }
    },
    "critical_error_weights": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
    },
    "release_thresholds": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "max_critical_error_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "max_false_exclusion_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "max_unsupported_value_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "min_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "min_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "min_run_to_run_reliability": {"type": "number", "minimum": 0, "maximum": 1},
        "max_mean_wall_clock_seconds": {"type": "number", "minimum": 0},
        "max_mean_total_cost": {"type": "number", "minimum": 0}
      }
    },
    "inference_limits": {
      "type": "object", "additionalProperties": false,
      "required": ["human_comparison_absent", "may_claim_human_superiority", "may_claim_labor_savings", "allowed_claim"],
      "properties": {
        "human_comparison_absent": {"const": true},
        "may_claim_human_superiority": {"const": false},
        "may_claim_labor_savings": {"const": false},
        "allowed_claim": {"const": "AI agreement with published expert references, reliability, risk-coverage, latency, and cost"}
      }
    },
    "frozen_at_utc": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "frozen"}}, "required": ["status"]},
      "then": {"properties": {"frozen_at_utc": {"type": "string", "format": "date-time"}}}
    }
  ]
}
