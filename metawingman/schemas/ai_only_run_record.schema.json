{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/ai_only_run_record.schema.json",
  "title": "MetaWingman scored AI-only benchmark run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "benchmark_id", "review_id", "review_family_id",
    "configuration_id", "repetition_index", "execution_mode", "human_interventions",
    "case_results", "wall_clock_seconds", "model_calls", "input_tokens", "output_tokens",
    "api_cost", "compute_cost", "cost_currency", "output_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "benchmark_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "review_id": {"type": "string", "minLength": 1},
    "review_family_id": {"type": "string", "minLength": 1},
    "configuration_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "repetition_index": {"type": "integer", "minimum": 1},
    "execution_mode": {"const": "ai_only"},
    "human_interventions": {"const": 0},
    "case_results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "case_id", "decision_sha256", "answered", "correct", "abstained",
          "critical_error", "false_exclusion", "unsupported_value"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "decision_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "answered": {"type": "boolean"},
          "correct": {"type": "boolean"},
          "abstained": {"type": "boolean"},
          "critical_error": {"type": "boolean"},
          "false_exclusion": {"type": "boolean"},
          "unsupported_value": {"type": "boolean"}
        },
        "allOf": [
          {
            "if": {"properties": {"abstained": {"const": true}}},
            "then": {"properties": {"answered": {"const": false}}}
          },
          {
            "if": {"properties": {"correct": {"const": true}}},
            "then": {"properties": {
              "answered": {"const": true},
              "abstained": {"const": false},
              "critical_error": {"const": false}
            }}
          }
        ]
      }
    },
    "wall_clock_seconds": {"type": "number", "minimum": 0},
    "model_calls": {"type": "integer", "minimum": 0},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "api_cost": {"type": "number", "minimum": 0},
    "compute_cost": {"type": "number", "minimum": 0},
    "cost_currency": {"type": "string", "minLength": 1},
    "output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
