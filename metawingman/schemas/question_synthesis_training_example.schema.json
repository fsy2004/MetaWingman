{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/question_synthesis_training_example.schema.json",
  "title": "MetaWingman bounded question-synthesis training example",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "example_id", "component_type", "task", "split", "family_id", "input", "target", "label_authority", "violated_rule", "source_anchor_ids", "created_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "example_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "component_type": {"enum": ["question_method_ranker", "source_support_verifier", "risk_cost_router"]},
    "task": {"enum": ["pairwise_preference", "binary_with_abstention", "bounded_loss_policy"]},
    "split": {"enum": ["train", "development", "calibration", "held_out"]},
    "family_id": {"type": "string", "minLength": 1},
    "input": {"type": "object"},
    "target": {
      "type": "object", "additionalProperties": false, "required": ["label", "decision"],
      "properties": {"label": {"type": "integer", "minimum": 0, "maximum": 1}, "decision": {"type": "string", "minLength": 1}}
    },
    "label_authority": {"const": "published_reference"},
    "violated_rule": {"type": ["string", "null"]},
    "source_anchor_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "created_at_utc": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"target": {"properties": {"label": {"const": 0}}}}}, "then": {"properties": {"violated_rule": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"target": {"properties": {"label": {"const": 1}}}}}, "then": {"properties": {"violated_rule": {"type": "null"}}}}
  ]
}
