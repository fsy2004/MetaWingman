{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/scientific_reflection.schema.json",
  "title": "MetaWingman externally tested scientific reflection",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "reflection_id", "assertion_id", "proposed_change", "external_tests", "created_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "reflection_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "assertion_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "proposed_change": {
      "type": "object", "additionalProperties": false, "required": ["field", "value"],
      "properties": {"field": {"type": "string", "minLength": 1}, "value": {}}
    },
    "external_tests": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["verifier_id", "input"],
        "properties": {"verifier_id": {"type": "string", "minLength": 1}, "input": {"type": "object"}}
      }
    },
    "created_at_utc": {"type": "string", "format": "date-time"}
  }
}
