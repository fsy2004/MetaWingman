{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/joint_reporting_stage_state.schema.json",
  "title": "Evidence-bound report and checklist review state",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema_version", "stage_id", "case_id", "arm_id", "seed", "certainty_state_artifact",
    "report_artifact", "checklist_manifest_artifact", "checklist_source_artifacts",
    "section_evidence_map", "checklist_audit", "all_checklist_items_accounted_for",
    "production_human_responsibility_pending", "published_reference_accessed"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "stage_id": {"const": "reporting_review"},
    "case_id": {"type": "string", "minLength": 1},
    "arm_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "certainty_state_artifact": {"$ref": "#/$defs/fileBinding"},
    "report_artifact": {"$ref": "#/$defs/fileBinding"},
    "checklist_manifest_artifact": {"$ref": "#/$defs/fileBinding"},
    "checklist_source_artifacts": {
      "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileBinding"}
    },
    "section_evidence_map": {"type": "object"},
    "checklist_audit": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "all_checklist_items_accounted_for": {"const": true},
    "production_human_responsibility_pending": {"const": true},
    "published_reference_accessed": {"const": false}
  },
  "$defs": {
    "fileBinding": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
