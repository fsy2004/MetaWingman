{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/biomedical_context.schema.json",
  "title": "MetaWingman biomedical application context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "context_id", "application_domain", "status", "review_family", "primary_specialty", "secondary_specialties", "question_framework", "terminology_releases", "source_classes", "languages", "geographies", "ood_assessment", "created_at_utc", "updated_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "context_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
    "application_domain": {"const": "human_health_clinical_translational_biomedicine"},
    "status": {"enum": ["draft", "frozen", "retired"]},
    "review_family": {"enum": ["intervention", "network", "diagnostic", "prognostic", "prediction-model", "etiology", "prevalence", "incidence", "harms", "dose-response", "ipd", "measurement", "scoping", "qualitative", "mixed-methods", "economic", "umbrella", "rapid", "living", "prospective", "other"]},
    "primary_specialty": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "secondary_specialties": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "uniqueItems": true},
    "question_framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "source_text", "normalized_concepts", "unresolved_terms"],
      "properties": {
        "framework": {"enum": ["PICO", "PECO", "PIRD", "PCC", "profile_specific"]},
        "source_text": {"type": "string"},
        "normalized_concepts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_phrase", "normalized_term", "identifier", "terminology", "pack_id"],
            "properties": {
              "source_phrase": {"type": "string", "minLength": 1},
              "normalized_term": {"type": "string", "minLength": 1},
              "identifier": {"type": "string"},
              "terminology": {"type": "string", "minLength": 1},
              "pack_id": {"type": "string", "minLength": 1}
            }
          }
        },
        "unresolved_terms": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "terminology_releases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system", "release", "source_url"],
        "properties": {
          "system": {"type": "string", "minLength": 1},
          "release": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "format": "uri"}
        }
      }
    },
    "source_classes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "languages": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]+)*$"}, "minItems": 1, "uniqueItems": true},
    "geographies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "ood_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_codes"],
      "properties": {
        "status": {"enum": ["in_scope", "uncertain", "out_of_scope"]},
        "reason_codes": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "uniqueItems": true}
      }
    },
    "created_at_utc": {"type": "string", "format": "date-time"},
    "updated_at_utc": {"type": "string", "format": "date-time"}
  }
}
