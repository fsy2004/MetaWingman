{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/joint_lifecycle_slot_result.schema.json",
  "title": "One case-arm-seed ten-stage execution result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "execution_id", "evaluation_plan_sha256", "case_slot_id",
    "arm_id", "seed", "status", "terminal_reason", "stage_results",
    "resource_totals", "published_reference_accessed", "created_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "execution_id": {"$ref": "#/$defs/identifier"},
    "evaluation_plan_sha256": {"$ref": "#/$defs/sha256"},
    "case_slot_id": {"$ref": "#/$defs/identifier"},
    "arm_id": {"$ref": "#/$defs/identifier"},
    "seed": {"type": "integer"},
    "status": {"enum": ["completed", "abstained", "failed"]},
    "terminal_reason": {"type": ["string", "null"], "minLength": 1},
    "stage_results": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/stageResult"}},
    "resource_totals": {"$ref": "#/$defs/resourceTotals"},
    "published_reference_accessed": {"const": false},
    "created_at_utc": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "stageId": {
      "enum": [
        "topic_feasibility", "protocol_registration", "search_retrieval",
        "selection", "data_lineage", "appraisal", "freeze_synthesis",
        "certainty_interpretation", "reporting_review", "living_update"
      ]
    },
    "countResource": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {"status": {"const": "observed"}, "value": {"type": "integer", "minimum": 0}}
    },
    "timeResource": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {"status": {"const": "observed"}, "value": {"type": "number", "minimum": 0}}
    },
    "costResource": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "value", "currency"],
      "properties": {
        "status": {"enum": ["known", "unknown", "not_applicable"]},
        "value": {"type": ["number", "null"], "minimum": 0},
        "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"}
      }
    },
    "resourceUsage": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_calls", "input_tokens", "output_tokens", "wall_seconds", "cost"],
      "properties": {
        "provider_calls": {"$ref": "#/$defs/countResource"},
        "input_tokens": {"$ref": "#/$defs/countResource"},
        "output_tokens": {"$ref": "#/$defs/countResource"},
        "wall_seconds": {"$ref": "#/$defs/timeResource"},
        "cost": {"$ref": "#/$defs/costResource"}
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": [
        "case_slot_id", "arm_id", "seed", "stage_id", "status",
        "checkpoint_sha256", "input_manifest_sha256", "output_manifest_sha256",
        "resource_usage"
      ],
      "properties": {
        "case_slot_id": {"$ref": "#/$defs/identifier"},
        "arm_id": {"$ref": "#/$defs/identifier"},
        "seed": {"type": "integer"},
        "stage_id": {"$ref": "#/$defs/stageId"},
        "status": {"enum": ["failed", "abstained", "locked"]},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "input_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "output_manifest_sha256": {"$ref": "#/$defs/nullableSha256"},
        "resource_usage": {"$ref": "#/$defs/resourceUsage"}
      }
    },
    "stageResult": {
      "type": "object", "additionalProperties": false,
      "required": [
        "ordinal", "stage_id", "status", "terminal_reason", "input_manifest_path",
        "input_manifest_sha256", "output_manifest_path", "output_manifest_sha256", "receipt"
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 9},
        "stage_id": {"$ref": "#/$defs/stageId"},
        "status": {"enum": ["locked", "abstained", "failed"]},
        "terminal_reason": {"type": ["string", "null"], "minLength": 1},
        "input_manifest_path": {"type": "string", "minLength": 1},
        "input_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "output_manifest_path": {"type": ["string", "null"], "minLength": 1},
        "output_manifest_sha256": {"$ref": "#/$defs/nullableSha256"},
        "receipt": {"$ref": "#/$defs/receipt"}
      }
    },
    "resourceTotals": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_calls", "input_tokens", "output_tokens", "wall_seconds", "cost"],
      "properties": {
        "provider_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "wall_seconds": {"type": "number", "minimum": 0},
        "cost": {"$ref": "#/$defs/costResource"}
      }
    }
  }
}
