{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/component_training_job.schema.json",
  "title": "MetaWingman frozen bounded-component training job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "created_at_utc", "component", "status", "reason_codes", "model", "dataset", "optimization", "resources", "output", "runtime", "seed", "command_argv"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "job_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "component": {"enum": ["section_role_classification", "evidence_retrieval"]},
    "status": {"enum": ["blocked", "ready_for_server_preflight"]},
    "reason_codes": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "uniqueItems": true},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_id", "revision", "tokenizer_revision", "model_card_url", "declared_license", "release_intent"],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "tokenizer_revision": {"type": "string", "minLength": 1},
        "model_card_url": {"type": "string", "format": "uri"},
        "declared_license": {"type": ["string", "null"]},
        "release_intent": {"enum": ["internal_research_only", "public_weights_pending_license_review"]}
      }
    },
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["run_plan_path", "run_plan_sha256", "examples_path", "examples_sha256", "pairs_path", "pairs_sha256", "train_examples", "development_examples", "train_pairs", "development_pairs", "family_isolation", "label_policy", "release_status"],
      "properties": {
        "run_plan_path": {"type": "string", "minLength": 1},
        "run_plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "examples_path": {"type": "string", "minLength": 1},
        "examples_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "pairs_path": {"type": "string", "minLength": 1},
        "pairs_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "train_examples": {"type": "integer", "minimum": 1},
        "development_examples": {"type": "integer", "minimum": 1},
        "train_pairs": {"type": "integer", "minimum": 0},
        "development_pairs": {"type": "integer", "minimum": 0},
        "family_isolation": {"const": true},
        "label_policy": {"const": "weak_candidates_not_gold"},
        "release_status": {"const": "raw_text_redistribution_forbidden_weights_pending_license_review"}
      }
    },
    "optimization": {
      "type": "object", "additionalProperties": false,
      "required": ["epochs", "batch_size", "learning_rate", "weight_decay", "warmup_ratio", "precision", "selection_metric"],
      "properties": {
        "epochs": {"type": "integer", "minimum": 1},
        "batch_size": {"type": "integer", "minimum": 1},
        "gradient_accumulation_steps": {"type": "integer", "minimum": 1, "default": 1},
        "learning_rate": {"type": "number", "exclusiveMinimum": 0},
        "weight_decay": {"type": "number", "minimum": 0},
        "warmup_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "precision": {"enum": ["fp32", "fp16", "bf16"]},
        "selection_metric": {"enum": ["macro_f1", "retrieval_recall_at_10"]}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["cpu_cores", "ram_gib", "gpu_count", "gpu_memory_gib_each", "storage_gib", "network_required"],
      "properties": {
        "cpu_cores": {"type": "integer", "minimum": 1},
        "ram_gib": {"type": "integer", "minimum": 1},
        "gpu_count": {"type": "integer", "minimum": 0},
        "gpu_memory_gib_each": {"type": "integer", "minimum": 0},
        "storage_gib": {"type": "integer", "minimum": 1},
        "network_required": {"type": "boolean"}
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "checkpoint_every_steps", "maximum_checkpoints", "resume_checkpoint_hashes"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "checkpoint_every_steps": {"type": "integer", "minimum": 1},
        "maximum_checkpoints": {"type": "integer", "minimum": 1},
        "resume_checkpoint_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "uniqueItems": true}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["lock_path", "lock_sha256", "python", "cuda_required"],
      "properties": {
        "lock_path": {"type": "string", "minLength": 1},
        "lock_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "python": {"type": "string", "pattern": "^3\\.[0-9]+$"},
        "cuda_required": {"type": "boolean"}
      }
    },
    "seed": {"type": "integer", "minimum": 0},
    "command_argv": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 2}
  }
}
