{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/evidence_acquisition_state.schema.json",
  "title": "MetaWingman conclusion-directed evidence acquisition state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_id",
    "protocol_version",
    "criterion_states",
    "global_signals",
    "thresholds",
    "candidate_actions",
    "created_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "state_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "protocol_version": {"type": "string", "minLength": 1},
    "criterion_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "critical",
          "calibration_status",
          "residual_omission_risk",
          "downstream_claim_impact",
          "hard_negative_error_rate",
          "unresolved_records",
          "independent_source_count",
          "evidence_basis"
        ],
        "properties": {
          "criterion_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "critical": {"type": "boolean"},
          "calibration_status": {"enum": ["calibrated", "heuristic", "unavailable"]},
          "residual_omission_risk": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "downstream_claim_impact": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "hard_negative_error_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "unresolved_records": {"type": "integer", "minimum": 0},
          "independent_source_count": {"type": "integer", "minimum": 0},
          "evidence_basis": {"type": "string", "minLength": 1}
        }
      }
    },
    "global_signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_context",
        "known_item_set_frozen",
        "known_item_recall",
        "source_family_count",
        "temporal_boundary_status",
        "leakage_audit"
      ],
      "properties": {
        "run_context": {"enum": ["production", "historical_reconstruction"]},
        "known_item_set_frozen": {"type": "boolean"},
        "known_item_recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "source_family_count": {"type": "integer", "minimum": 0},
        "temporal_boundary_status": {"enum": ["not_applicable", "sealed", "unsealed", "contaminated"]},
        "leakage_audit": {"enum": ["not_applicable", "passed", "not_run", "failed"]}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known_item_recall_floor",
        "residual_omission_risk_ceiling",
        "downstream_claim_impact_ceiling",
        "hard_negative_error_ceiling",
        "minimum_independent_sources",
        "minimum_source_families",
        "max_selected_actions"
      ],
      "properties": {
        "known_item_recall_floor": {"type": "number", "minimum": 0, "maximum": 1},
        "residual_omission_risk_ceiling": {"type": "number", "minimum": 0, "maximum": 1},
        "downstream_claim_impact_ceiling": {"type": "number", "minimum": 0, "maximum": 1},
        "hard_negative_error_ceiling": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_independent_sources": {"type": "integer", "minimum": 1},
        "minimum_source_families": {"type": "integer", "minimum": 1},
        "max_selected_actions": {"type": "integer", "minimum": 1, "maximum": 20}
      }
    },
    "candidate_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "action_type",
          "target_criterion_ids",
          "expected_risk_reduction",
          "expected_claim_impact",
          "source_family_gain",
          "estimated_cost_units",
          "estimate_basis",
          "legally_available",
          "credential_status",
          "rationale"
        ],
        "properties": {
          "action_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "action_type": {
            "enum": [
              "known_item_audit",
              "query_expansion",
              "add_source",
              "citation_chasing",
              "registry_search",
              "retrieve_full_text",
              "screen_priority_batch",
              "resolve_metadata",
              "resolve_lineage",
              "author_contact",
              "verify_screening_decision",
              "verify_extraction",
              "verify_claim_consistency",
              "recompute_synthesis"
            ]
          },
          "target_criterion_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
          },
          "expected_risk_reduction": {"type": "number", "minimum": 0, "maximum": 1},
          "expected_claim_impact": {"type": "number", "minimum": 0, "maximum": 1},
          "source_family_gain": {"type": "integer", "minimum": 0},
          "estimated_cost_units": {"type": "number", "exclusiveMinimum": 0},
          "estimate_basis": {"enum": ["calibrated", "historical", "heuristic"]},
          "legally_available": {"type": "boolean"},
          "credential_status": {"enum": ["not_required", "available", "human_handoff", "unavailable"]},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "created_at_utc": {"type": "string", "format": "date-time"}
  }
}
