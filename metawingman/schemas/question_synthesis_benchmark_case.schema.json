{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/question_synthesis_benchmark_case.schema.json",
  "title": "MetaWingman sealed question-synthesis benchmark case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "review_family_id",
    "dependency_family_ids",
    "graph_node_ids",
    "descendant_source_record_ids",
    "cutoff_at_utc",
    "visible_material",
    "sealed_target",
    "published_reference",
    "leakage_patterns",
    "loss_rubric",
    "split",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "review_family_id": {"type": "string", "pattern": "\\S"},
    "dependency_family_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S"}
    },
    "graph_node_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S"}
    },
    "descendant_source_record_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S"}
    },
    "cutoff_at_utc": {"type": "string", "format": "date-time"},
    "visible_material": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "material_id",
          "filename",
          "text",
          "source_node_ids",
          "source_record_ids",
          "observed_at_utc",
          "sha256"
        ],
        "properties": {
          "material_id": {"type": "string", "pattern": "\\S"},
          "filename": {"type": "string", "pattern": "\\S"},
          "text": {"type": "string"},
          "source_node_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "\\S"}
          },
          "source_record_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "\\S"}
          },
          "observed_at_utc": {"type": "string", "format": "date-time"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "sealed_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "doi", "authors"],
      "properties": {
        "title": {"type": "string", "pattern": "\\S"},
        "doi": {"type": "string", "pattern": "\\S"},
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "\\S"}
        },
        "identifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "\\S"}
        }
      }
    },
    "published_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_family", "synthesis_route", "status", "verification"],
      "properties": {
        "review_family": {"type": "string", "pattern": "\\S"},
        "synthesis_route": {"type": "string", "pattern": "\\S"},
        "status": {"enum": ["published_reference", "verified_corrected_version"]},
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correction_or_corrigendum_handling",
            "retraction_check",
            "protocol_version_audit",
            "reproduction_ceiling",
            "verified_at_utc",
            "source_urls"
          ],
          "properties": {
            "correction_or_corrigendum_handling": {"type": "string", "pattern": "\\S"},
            "retraction_check": {"type": "string", "pattern": "\\S"},
            "protocol_version_audit": {"type": "string", "pattern": "\\S"},
            "reproduction_ceiling": {"type": "string", "pattern": "\\S"},
            "verified_at_utc": {"type": "string", "format": "date-time"},
            "source_urls": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "format": "uri"}
            }
          }
        }
      }
    },
    "leakage_patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S"}
    },
    "loss_rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correct", "abstain", "critical_error"],
      "properties": {
        "correct": {"type": "number"},
        "abstain": {"type": "number"},
        "critical_error": {"type": "number"}
      }
    },
    "split": {"enum": ["development", "calibration", "held_out", "prospective"]},
    "status": {"enum": ["draft", "sealed", "invalidated"]}
  }
}
