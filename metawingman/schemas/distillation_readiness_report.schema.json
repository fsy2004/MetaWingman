{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/distillation_readiness_report.schema.json",
  "title": "MetaWingman fail-closed student-distillation readiness report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "audit_status", "ready_for_student_training",
    "case_registry", "inputs", "counts", "family_closure", "checkpoint_closure",
    "eligible_example_ids", "exclusions", "blockers"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "audit_status": {"const": "valid_fail_closed_audit"},
    "ready_for_student_training": {"type": "boolean"},
    "case_registry": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "cases"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "cases": {"type": "integer", "minimum": 0}
      }
    },
    "inputs": {
      "type": "object", "additionalProperties": false,
      "required": [
        "trajectory_exports", "lineage_manifest_path", "revocation_manifest_path"
      ],
      "properties": {
        "trajectory_exports": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "lineage_manifest_path": {"type": ["string", "null"]},
        "revocation_manifest_path": {"type": ["string", "null"]}
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["candidates", "trainable"],
      "properties": {
        "candidates": {"$ref": "#/$defs/counts"},
        "trainable": {"$ref": "#/$defs/counts"}
      }
    },
    "family_closure": {
      "type": "object", "additionalProperties": false,
      "required": ["referenced_families", "verified_families"],
      "properties": {
        "referenced_families": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "verified_families": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "checkpoint_closure": {
      "type": "object", "additionalProperties": false,
      "required": ["referenced_checkpoints", "verified_checkpoints"],
      "properties": {
        "referenced_checkpoints": {"type": "integer", "minimum": 0},
        "verified_checkpoints": {"type": "integer", "minimum": 0}
      }
    },
    "eligible_example_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["example_id", "reasons"],
        "properties": {
          "example_id": {"type": "string", "minLength": 1},
          "reasons": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "blockers": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["positive", "negative", "abstention", "audit_only", "quarantine", "total"],
      "properties": {
        "positive": {"type": "integer", "minimum": 0},
        "negative": {"type": "integer", "minimum": 0},
        "abstention": {"type": "integer", "minimum": 0},
        "audit_only": {"type": "integer", "minimum": 0},
        "quarantine": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      }
    }
  }
}
