{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/evidence_acquisition_loop_result.schema.json",
  "title": "Risk-impact evidence acquisition loop result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "loop_id", "status", "terminal_reason", "initial_state_sha256", "final_state_sha256", "decisions", "action_receipts", "usage_totals", "stop_authority", "full_risk_impact_controller_instantiated", "created_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "loop_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "status": {"enum": ["completed", "abstained", "awaiting_stop_authority"]},
    "terminal_reason": {"type": "string", "minLength": 1},
    "initial_state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "final_state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decisions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "action_receipts": {"type": "array", "items": {"type": "object"}},
    "usage_totals": {
      "type": "object", "additionalProperties": false,
      "required": ["actions", "estimated_cost_units", "model_calls", "input_tokens", "output_tokens", "wall_seconds", "cost_status", "cost_value"],
      "properties": {
        "actions": {"type": "integer", "minimum": 0},
        "estimated_cost_units": {"type": "number", "minimum": 0},
        "model_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "wall_seconds": {"type": "number", "minimum": 0},
        "cost_status": {"enum": ["known", "unknown", "not_applicable"]},
        "cost_value": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "stop_authority": {"type": "object"},
    "full_risk_impact_controller_instantiated": {"type": "boolean"},
    "created_at_utc": {"type": "string", "format": "date-time"}
  }
}
