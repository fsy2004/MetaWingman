{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/joint_lineage_stage_config.schema.json",
  "title": "Frozen full-text lineage and extraction configuration",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema_version", "stage_id", "adapter_id", "provider_config",
    "maximum_fulltext_characters", "maximum_input_tokens_per_call",
    "maximum_output_tokens_per_call", "thinking"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "stage_id": {"const": "data_lineage"},
    "adapter_id": {"const": "joint-report-study-result-estimand-v1"},
    "provider_config": {"$ref": "#/$defs/fileBinding"},
    "maximum_fulltext_characters": {"type": "integer", "minimum": 1000},
    "maximum_input_tokens_per_call": {"type": "integer", "minimum": 1},
    "maximum_output_tokens_per_call": {"type": "integer", "minimum": 1},
    "thinking": {"type": "boolean"}
  },
  "$defs": {
    "fileBinding": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "not": {"pattern": "^(?:[A-Za-z]:|/|\\\\)"}},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
