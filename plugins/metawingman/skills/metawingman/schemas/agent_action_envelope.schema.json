{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/agent_action_envelope.schema.json",
  "title": "MetaWingman bounded agent action envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "turn_id", "session_id", "task_id", "control_refs",
    "observation_ids", "action", "tool_contract_id", "expected_output_schema",
    "attempt", "max_attempts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "turn_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "session_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "control_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control_id", "source", "sha256"],
        "properties": {
          "control_id": {"type": "string", "minLength": 1},
          "source": {"enum": ["system", "user", "protocol"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "observation_ids": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "action": {"type": "object"},
    "tool_contract_id": {"type": "string", "minLength": 1},
    "expected_output_schema": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10}
  }
}
