{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/effect_estimate.schema.json",
  "title": "MetaWingman deterministically recomputed effect estimate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "effect_id", "result_id", "measure", "scale", "direction",
    "estimate", "standard_error", "variance", "confidence_level", "ci_lower",
    "ci_upper", "back_transformed", "input_candidate_ids", "formula",
    "continuity_correction", "software", "verification", "created_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "effect_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "result_id": {"type": "string", "minLength": 1},
    "measure": {
      "enum": ["log_risk_ratio", "log_odds_ratio", "risk_difference", "mean_difference", "standardized_mean_difference", "fisher_z", "logit_proportion", "generic"]
    },
    "scale": {"enum": ["log", "identity", "fisher_z", "logit"]},
    "direction": {"enum": ["higher_favors_intervention", "lower_favors_intervention", "higher_is_harm", "lower_is_harm", "descriptive", "other"]},
    "estimate": {"type": "number"},
    "standard_error": {"type": "number", "exclusiveMinimum": 0},
    "variance": {"type": "number", "exclusiveMinimum": 0},
    "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "ci_lower": {"type": "number"},
    "ci_upper": {"type": "number"},
    "back_transformed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measure", "estimate", "ci_lower", "ci_upper"],
      "properties": {
        "measure": {"type": "string", "minLength": 1},
        "estimate": {"type": "number"},
        "ci_lower": {"type": "number"},
        "ci_upper": {"type": "number"}
      }
    },
    "input_candidate_ids": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}, "uniqueItems": true
    },
    "formula": {"type": "string", "minLength": 1},
    "continuity_correction": {"type": ["number", "null"], "minimum": 0},
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "metawingman-effect-recalculator"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks", "tolerance"],
      "properties": {
        "status": {"const": "passed"},
        "checks": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}, "uniqueItems": true
        },
        "tolerance": {"type": "number", "minimum": 0}
      }
    },
    "created_at_utc": {"type": "string", "format": "date-time"}
  }
}
