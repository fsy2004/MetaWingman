{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/model_registry.schema.json",
  "title": "MetaWingman capability-based model registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "models"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model_id", "provider", "model", "version", "capabilities", "modalities", "context_tokens", "allowed_tools", "cost", "latency_class", "calibration"],
        "properties": {
          "model_id": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "modalities": {"type": "array", "items": {"enum": ["text", "image", "pdf", "audio", "structured_data"]}, "minItems": 1, "uniqueItems": true},
          "context_tokens": {"type": "integer", "minimum": 1},
          "allowed_tools": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input_per_million", "output_per_million", "currency"],
            "properties": {
              "input_per_million": {"type": ["number", "null"], "minimum": 0},
              "output_per_million": {"type": ["number", "null"], "minimum": 0},
              "currency": {"const": "USD"}
            }
          },
          "latency_class": {"enum": ["fast", "standard", "slow", "batch"]},
          "calibration": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dataset_id", "evaluated_at", "metrics"],
            "properties": {
              "dataset_id": {"type": "string"},
              "evaluated_at": {"type": "string"},
              "metrics": {"type": "object", "additionalProperties": {"type": "number"}}
            }
          }
        }
      }
    }
  }
}
