{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/appraisal_framework_adapter.schema.json",
  "title": "MetaWingman pinned appraisal framework adapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "adapter_id", "adapter_version", "framework",
    "supported_review_families", "target_granularity", "domains",
    "allowed_answers", "final_human_signature_required", "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "adapter_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "adapter_version": {"type": "string", "minLength": 1},
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "organization", "source_url", "verified_at_utc"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "organization": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"},
        "verified_at_utc": {"type": "string", "format": "date-time"}
      }
    },
    "supported_review_families": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}, "uniqueItems": true
    },
    "target_granularity": {"enum": ["study", "result", "synthesis"]},
    "domains": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain_id", "label", "signaling_question_ids", "notes"],
        "properties": {
          "domain_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "label": {"type": "string", "minLength": 1},
          "signaling_question_ids": {
            "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
          },
          "notes": {"type": "string"}
        }
      }
    },
    "allowed_answers": {
      "type": "array", "minItems": 1,
      "items": {"enum": ["yes", "probably_yes", "probably_no", "no", "no_information", "not_applicable"]},
      "uniqueItems": true
    },
    "final_human_signature_required": {"const": true},
    "status": {"enum": ["verified", "experimental", "retired"]}
  }
}
