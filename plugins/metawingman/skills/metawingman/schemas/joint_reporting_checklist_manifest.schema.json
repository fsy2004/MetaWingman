{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/joint_reporting_checklist_manifest.schema.json",
  "title": "License-audited reporting checklist mapping",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "guideline", "version", "source_url", "license_or_permission", "source_artifacts", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "guideline": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "license_or_permission": {"type": "string", "minLength": 1},
    "source_artifacts": {
      "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileBinding"}
    },
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["item_id", "required_section", "requirement", "coverage_rule_id"],
        "properties": {
          "item_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "required_section": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "requirement": {"type": "string", "minLength": 1},
          "coverage_rule_id": {
            "enum": [
              "title", "abstract", "rationale", "objectives", "eligibility", "information_sources",
              "search_strategy", "selection_process", "data_collection_process", "outcome_data_items",
              "other_data_items", "risk_of_bias_methods", "effect_measures", "synthesis_eligibility",
              "data_preparation", "display_methods", "synthesis_methods", "heterogeneity_methods",
              "sensitivity_methods", "reporting_bias_methods", "certainty_methods", "selection_results",
              "excluded_studies", "study_characteristics", "risk_of_bias_results", "individual_study_results",
              "synthesis_characteristics", "synthesis_results", "heterogeneity_results", "sensitivity_results",
              "reporting_bias_results", "certainty_results", "interpretation", "evidence_limitations",
              "review_process_limitations", "implications", "registration", "protocol_access", "amendments",
              "support", "competing_interests", "data_code_availability"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "fileBinding": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "not": {"pattern": "^(?:[A-Za-z]:|/|\\\\)"}},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
