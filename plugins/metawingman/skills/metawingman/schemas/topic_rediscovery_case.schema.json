{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/topic_rediscovery_case.schema.json",
  "title": "MetaWingman sealed topic rediscovery evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "review_family_id", "split", "cutoff_date", "run_lock",
    "exposure_audit", "model_memory_boundary", "ranked_predictions", "sealed_reference", "evaluation_policy"
  ],
  "$defs": {
    "term_set": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population", "intervention_or_exposure", "comparator", "outcome", "study_design", "synthesis_route"],
      "properties": {
        "population": {"$ref": "#/$defs/term_set"},
        "intervention_or_exposure": {"$ref": "#/$defs/term_set"},
        "comparator": {"$ref": "#/$defs/term_set"},
        "outcome": {"$ref": "#/$defs/term_set"},
        "study_design": {"$ref": "#/$defs/term_set"},
        "synthesis_route": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "review_family_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "split": {"enum": ["train", "development", "test", "prospective"]},
    "cutoff_date": {"type": "string", "format": "date"},
    "run_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locked", "locked_at_utc", "artifact_sha256"],
      "properties": {
        "locked": {"const": true},
        "locked_at_utc": {"type": "string", "format": "date-time"},
        "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "exposure_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "target_identity_exposed", "target_descendants_exposed", "post_cutoff_evidence_exposed"],
      "properties": {
        "status": {"const": "passed"},
        "target_identity_exposed": {"const": false},
        "target_descendants_exposed": {"const": false},
        "post_cutoff_evidence_exposed": {"const": false}
      }
    },
    "model_memory_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_version_frozen", "training_cutoff_status", "memorization_probe",
        "contamination_risk", "prospective_run_registered_before_reference"
      ],
      "properties": {
        "model_version_frozen": {"type": "boolean"},
        "training_cutoff_status": {"enum": ["documented_before_target", "unknown", "target_may_be_in_training", "not_applicable_prospective"]},
        "memorization_probe": {"enum": ["passed_no_target_recall", "failed_target_recall", "inconclusive", "not_run"]},
        "contamination_risk": {"enum": ["low", "medium", "high", "unquantifiable"]},
        "prospective_run_registered_before_reference": {"type": "boolean"}
      }
    },
    "ranked_predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "candidate_id", "question_framework"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "question_framework": {"$ref": "#/$defs/question"}
        }
      }
    },
    "sealed_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_status", "published_identity_sha256", "venue_stratum", "question_framework"],
      "properties": {
        "reference_status": {"enum": ["published_expert_reference", "published_corrected_reference"]},
        "published_identity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "venue_stratum": {"enum": ["top_general", "top_field", "other_peer_reviewed", "prospective_not_published"]},
        "question_framework": {"$ref": "#/$defs/question"}
      }
    },
    "evaluation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top_k", "minimum_framework_similarity", "field_weights"],
      "properties": {
        "top_k": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 1000}},
        "minimum_framework_similarity": {"type": "number", "minimum": 0, "maximum": 1},
        "field_weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["population", "intervention_or_exposure", "comparator", "outcome", "study_design", "synthesis_route"],
          "properties": {
            "population": {"type": "number", "minimum": 0, "maximum": 1},
            "intervention_or_exposure": {"type": "number", "minimum": 0, "maximum": 1},
            "comparator": {"type": "number", "minimum": 0, "maximum": 1},
            "outcome": {"type": "number", "minimum": 0, "maximum": 1},
            "study_design": {"type": "number", "minimum": 0, "maximum": 1},
            "synthesis_route": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    }
  }
}
