{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/joint_search_calibration_manifest.schema.json",
  "title": "Frozen non-target search calibration sentinels",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "purpose", "target_reference_derived", "criteria", "sentinels"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "purpose": {"const": "operational_search_calibration_only"},
    "target_reference_derived": {"const": false},
    "criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterion_id", "critical", "downstream_claim_impact", "hard_negative_error_rate"],
        "properties": {
          "criterion_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "critical": {"type": "boolean"},
          "downstream_claim_impact": {"type": "number", "minimum": 0, "maximum": 1},
          "hard_negative_error_rate": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "sentinels": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sentinel_id", "identifier_type", "identifier", "criterion_ids"],
        "properties": {
          "sentinel_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "identifier_type": {"enum": ["doi", "pmid", "pmcid", "nct_id"]},
          "identifier": {"type": "string", "minLength": 1},
          "criterion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}}
        }
      }
    }
  }
}
