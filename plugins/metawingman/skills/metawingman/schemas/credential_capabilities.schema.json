{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/credential_capabilities.schema.json",
  "title": "MetaWingman credential-free capability registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "secret_storage_policy", "capabilities"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "secret_storage_policy": {"const": "environment_or_user_approved_secret_store_only"},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id", "provider", "purpose", "access_class", "status",
          "required_environment_variables", "optional_environment_variables",
          "credential_owner", "last_tested_at_utc", "notes"
        ],
        "properties": {
          "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "provider": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "access_class": {"enum": ["public_no_account", "contact_email", "optional_api_key", "model_api", "local_application", "institutional_handoff", "user_provided"]},
          "status": {"enum": ["available", "unconfigured", "disabled", "blocked", "not_required"]},
          "required_environment_variables": {
            "type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}, "uniqueItems": true
          },
          "optional_environment_variables": {
            "type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}, "uniqueItems": true
          },
          "credential_owner": {"type": "string"},
          "last_tested_at_utc": {"type": ["string", "null"], "format": "date-time"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
