{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/end_to_end_reconstruction_plan.schema.json",
  "title": "Blind end-to-end systematic-review reconstruction execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_id", "frozen_at_utc", "operational_root",
    "sealed_root", "runtime", "cases", "configurations", "seeds", "slots"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "frozen_at_utc": {"type": "string", "format": "date-time"},
    "operational_root": {"type": "string", "minLength": 1},
    "sealed_root": {"type": "string", "minLength": 1},
    "runtime": {"$ref": "#/$defs/runtime"},
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/case"}
    },
    "configurations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/configuration"}
    },
    "seeds": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"type": "integer"}
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/slot"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id", "provider_config_path", "provider_config_sha256",
        "prompt_files", "tool_files", "matched_budget", "command_argv"
      ],
      "properties": {
        "model_id": {"const": "deepseek-v4-flash"},
        "provider_config_path": {"type": "string", "minLength": 1},
        "provider_config_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file_binding"}},
        "tool_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file_binding"}},
        "matched_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_model_calls", "max_input_tokens", "max_output_tokens", "retry_limit", "wall_seconds"],
          "properties": {
            "max_model_calls": {"type": "integer", "minimum": 1},
            "max_input_tokens": {"type": "integer", "minimum": 1},
            "max_output_tokens": {"type": "integer", "minimum": 1},
            "retry_limit": {"type": "integer", "minimum": 0},
            "wall_seconds": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "command_argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id", "review_family_id", "split", "operational_path",
        "operational_sha256", "sealed_reference_path", "sealed_reference_sha256"
      ],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "review_family_id": {"type": "string", "pattern": "\\S"},
        "split": {"enum": ["development", "calibration", "held_out"]},
        "operational_path": {"type": "string", "minLength": 1},
        "operational_sha256": {"$ref": "#/$defs/sha256"},
        "sealed_reference_path": {"type": "string", "minLength": 1},
        "sealed_reference_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration_id", "topic_opportunity_control",
        "conclusion_directed_acquisition"
      ],
      "properties": {
        "configuration_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "topic_opportunity_control": {"type": "boolean"},
        "conclusion_directed_acquisition": {"type": "boolean"}
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "configuration_id", "seed"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "configuration_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "seed": {"type": "integer"}
      }
    }
  }
}
