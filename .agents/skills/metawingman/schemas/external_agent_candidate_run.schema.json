{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/external_agent_candidate_run.schema.json",
  "title": "MetaWingman external-agent structured candidate run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "status", "output_schema", "input_sha256",
    "instruction_sha256", "candidate", "reason_codes", "provider_provenance",
    "attempt_usage", "usage_totals", "request_budget", "attempts",
    "acceptance_boundary", "created_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "status": {"enum": ["candidate_generated", "abstain"]},
    "output_schema": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "instruction_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate": {"type": ["object", "null"]},
    "reason_codes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9_]+$"},
      "uniqueItems": true
    },
    "provider_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider", "model", "finish_reason", "content_sha256", "prompt_tokens",
        "completion_tokens", "total_tokens", "reasoning_tokens", "system_fingerprint",
        "credential_source"
      ],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "finish_reason": {"type": "string", "minLength": 1},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
        "completion_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
        "system_fingerprint": {"type": ["string", "null"]},
        "credential_source": {"type": "string", "minLength": 1}
      }
    },
    "attempt_usage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase", "content_sha256", "prompt_tokens", "completion_tokens",
          "total_tokens", "reasoning_tokens"
        ],
        "properties": {
          "phase": {"enum": ["initial_generation", "schema_repair"]},
          "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
          "completion_tokens": {"type": ["integer", "null"], "minimum": 0},
          "total_tokens": {"type": ["integer", "null"], "minimum": 0},
          "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "usage_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_tokens", "completion_tokens", "total_tokens", "reasoning_tokens"],
      "properties": {
        "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
        "completion_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "request_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tokens_per_call", "max_attempts"],
      "properties": {
        "max_tokens_per_call": {"type": "integer", "minimum": 1, "maximum": 8192},
        "max_attempts": {"const": 2}
      }
    },
    "attempts": {"type": "integer", "minimum": 1, "maximum": 2},
    "acceptance_boundary": {"const": "candidate_only_requires_workflow_gate"},
    "created_at_utc": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"attempts": {"const": 1}}},
      "then": {"properties": {"attempt_usage": {"minItems": 1, "maxItems": 1}}}
    },
    {
      "if": {"properties": {"attempts": {"const": 2}}},
      "then": {"properties": {"attempt_usage": {"minItems": 2, "maxItems": 2}}}
    },
    {
      "if": {"properties": {"status": {"const": "candidate_generated"}}},
      "then": {"properties": {"candidate": {"type": "object"}}}
    },
    {
      "if": {"properties": {"status": {"const": "abstain"}}},
      "then": {
        "properties": {
          "candidate": {"type": "null"},
          "reason_codes": {"minItems": 1}
        }
      }
    }
  ]
}
