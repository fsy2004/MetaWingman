{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/training_run_plan.schema.json",
  "title": "MetaWingman model-neutral training run plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_plan_id", "created_at_utc", "dataset", "model_contract", "objectives", "evaluation", "contamination_controls", "execution_state"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_plan_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_path", "manifest_sha256", "examples_path", "examples_sha256", "train_examples", "development_examples", "held_out_examples"],
      "properties": {
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "examples_path": {"type": "string", "minLength": 1},
        "examples_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "train_examples": {"type": "integer", "minimum": 0},
        "development_examples": {"type": "integer", "minimum": 0},
        "held_out_examples": {"const": 0}
      }
    },
    "model_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_neutral", "base_model", "revision", "tokenizer_revision", "license_review_required_before_training"],
      "properties": {
        "provider_neutral": {"const": true},
        "base_model": {"type": ["string", "null"]},
        "revision": {"type": ["string", "null"]},
        "tokenizer_revision": {"type": ["string", "null"]},
        "license_review_required_before_training": {"const": true}
      }
    },
    "objectives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["section_role_classification", "evidence_retrieval"]}},
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "metrics", "selection_uses_development_only", "scientific_claims_disabled"],
      "properties": {
        "unit": {"const": "review_family"},
        "metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["macro_f1", "family_bootstrap_accuracy", "retrieval_recall_at_k", "selective_accuracy", "abstention_rate"]}},
        "selection_uses_development_only": {"const": true},
        "scientific_claims_disabled": {"const": true}
      }
    },
    "contamination_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_isolation", "journal_feature_forbidden", "published_answer_is_not_oracle", "model_memory_risk_recorded"],
      "properties": {
        "family_isolation": {"const": true},
        "journal_feature_forbidden": {"const": true},
        "published_answer_is_not_oracle": {"const": true},
        "model_memory_risk_recorded": {"const": true}
      }
    },
    "execution_state": {"const": "planned_not_trained"}
  }
}
