{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/topic_opportunity_decision.schema.json",
  "title": "MetaWingman topic opportunity portfolio decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision_id", "landscape_id", "landscape_sha256", "candidate_set_sha256",
    "policy_version", "status", "ranked_candidates", "selected_candidate_ids", "reason_codes",
    "oversight_boundary", "created_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "decision_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "landscape_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "landscape_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_set_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["portfolio_selected", "abstain"]},
    "ranked_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "eligible", "base_utility", "marginal_utility", "rank", "selected", "component_contributions", "reason_codes"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "eligible": {"type": "boolean"},
          "base_utility": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "marginal_utility": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
          "rank": {"type": ["integer", "null"], "minimum": 1},
          "selected": {"type": "boolean"},
          "component_contributions": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
          "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "selected_candidate_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
    },
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "oversight_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "intervention_during_run_allowed", "final_topic_signature_required"],
      "properties": {
        "mode": {"enum": ["final_topic_signature", "post_run_reference_only"]},
        "intervention_during_run_allowed": {"type": "boolean"},
        "final_topic_signature_required": {"type": "boolean"}
      }
    },
    "created_at_utc": {"type": "string", "format": "date-time"}
  }
}
