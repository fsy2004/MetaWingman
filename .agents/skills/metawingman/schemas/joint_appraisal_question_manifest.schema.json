{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/joint_appraisal_question_manifest.schema.json",
  "title": "License-audited appraisal signaling question manifest",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "framework_adapter_id", "license_or_permission", "questions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "framework_adapter_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "license_or_permission": {"type": "string", "minLength": 1},
    "questions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["question_id", "question"],
        "properties": {
          "question_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "question": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
