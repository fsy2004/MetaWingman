{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/training_corpus_plan.schema.json",
  "title": "MetaWingman reproducible training corpus plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "created_at_utc", "inputs", "policy", "summary", "records"],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "plan_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_corpus_path", "source_corpus_sha256", "family_registry_path", "family_registry_sha256"],
      "properties": {
        "source_corpus_path": {"type": "string", "minLength": 1},
        "source_corpus_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "family_registry_path": {"type": "string", "minLength": 1},
        "family_registry_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "specialty_registry_path": {"type": "string", "minLength": 1},
        "specialty_registry_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "maximum_records", "train_fraction", "split_policy", "held_out_enabled", "journal_is_stratum_not_oracle", "require_open_access", "require_pmcid", "allowed_licenses", "label_policy"],
      "properties": {
        "seed": {"type": "integer", "minimum": 0},
        "maximum_records": {"type": "integer", "minimum": 1},
        "train_fraction": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "split_policy": {"const": "review_family_hash_train_development_only"},
        "held_out_enabled": {"const": false},
        "journal_is_stratum_not_oracle": {"const": true},
        "require_open_access": {"const": true},
        "require_pmcid": {"const": true},
        "allowed_licenses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "label_policy": {"const": "source_anchored_weak_supervision_until_independently_verified"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_records", "selected_records", "train_records", "development_records", "selected_families", "selected_journals"],
      "properties": {
        "eligible_records": {"type": "integer", "minimum": 0},
        "selected_records": {"type": "integer", "minimum": 0},
        "train_records": {"type": "integer", "minimum": 0},
        "development_records": {"type": "integer", "minimum": 0},
        "selected_families": {"type": "integer", "minimum": 0},
        "selected_journals": {"type": "integer", "minimum": 0}
      }
    },
    "domain_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_domain", "classifier_version", "source_fields", "journal_feature_forbidden", "label_status"],
      "properties": {
        "application_domain": {"const": "human_health_clinical_translational_biomedicine"},
        "classifier_version": {"const": "biomedical-title-terms-v1"},
        "source_fields": {"const": ["title", "publication_types"]},
        "journal_feature_forbidden": {"const": true},
        "label_status": {"const": "deterministic_weak_candidate"}
      }
    },
    "strata_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampling_keys", "primary_specialties", "question_types"],
      "properties": {
        "sampling_keys": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "primary_specialties": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "question_types": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "family_id", "split", "split_status", "title", "year", "journal", "journal_stratum", "doi", "pmid", "pmcid", "declared_license", "source_url", "integrity_status"],
        "properties": {
          "record_id": {"type": "string", "pattern": "^epmc:"},
          "family_id": {"type": "string", "pattern": "^family:[a-f0-9]{16}$"},
          "split": {"enum": ["train", "development"]},
          "split_status": {"const": "provisional_family_isolated_not_held_out"},
          "title": {"type": "string", "minLength": 1},
          "year": {"type": "integer", "minimum": 1990},
          "journal": {"type": "string", "minLength": 1},
          "journal_stratum": {"type": "string", "minLength": 1},
          "doi": {"type": "string"},
          "pmid": {"type": "string"},
          "pmcid": {"type": "string", "pattern": "^PMC[0-9]+$"},
          "declared_license": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "format": "uri"},
          "integrity_status": {"const": "no_status_update_in_epmc_record"},
          "biomedical_stratum": {"$ref": "#/$defs/biomedical_stratum"}
        }
      }
    }
  },
  "$defs": {
    "biomedical_stratum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "primary_specialty", "secondary_specialties", "question_type", "study_designs", "synthesis_routes", "languages", "document_modalities", "challenge_tags", "sampling_key", "label_status", "evidence"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "primary_specialty": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "secondary_specialties": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "question_type": {"type": "string", "minLength": 1},
        "study_designs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "synthesis_routes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "languages": {"type": "array", "items": {"type": "string", "minLength": 2}, "minItems": 1, "uniqueItems": true},
        "document_modalities": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "challenge_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "sampling_key": {"type": "string", "minLength": 1},
        "label_status": {"const": "deterministic_weak_candidate"},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.1"}}, "required": ["schema_version"]},
      "then": {
        "required": ["domain_policy", "strata_summary"],
        "properties": {
          "inputs": {"required": ["specialty_registry_path", "specialty_registry_sha256"]},
          "records": {"items": {"required": ["biomedical_stratum"]}}
        }
      },
      "else": {
        "not": {"anyOf": [{"required": ["domain_policy"]}, {"required": ["strata_summary"]}]}
      }
    }
  ]
}
