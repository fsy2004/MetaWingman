{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/training_document_manifest.schema.json",
  "title": "MetaWingman fetched training document manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "created_at_utc", "plan_id", "plan_sha256", "source_policy", "summary", "documents"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata_api", "full_text_api", "license_api", "public_https_only", "article_level_license_required", "retractions_rejected"],
      "properties": {
        "metadata_api": {"const": "Europe PMC REST"},
        "full_text_api": {"const": "Europe PMC OA"},
        "license_api": {"const": "PMC OA Web Service"},
        "public_https_only": {"const": true},
        "article_level_license_required": {"const": true},
        "retractions_rejected": {"const": true}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned", "complete", "partial", "failed", "pdf_files", "xml_files", "total_bytes"],
      "properties": {
        "planned": {"type": "integer", "minimum": 0},
        "complete": {"type": "integer", "minimum": 0},
        "partial": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "pdf_files": {"type": "integer", "minimum": 0},
        "xml_files": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "record_id", "family_id", "split", "pmcid", "title", "license", "integrity_status", "retrieval_status", "failure_reasons", "artifacts", "parser_metrics", "label_status"],
        "properties": {
          "document_id": {"type": "string", "pattern": "^training-document:"},
          "record_id": {"type": "string", "pattern": "^epmc:"},
          "family_id": {"type": "string", "pattern": "^family:"},
          "split": {"enum": ["train", "development"]},
          "pmcid": {"type": "string", "pattern": "^PMC[0-9]+$"},
          "title": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "integrity_status": {"enum": ["verified_not_retracted", "unverified", "rejected_retracted"]},
          "retrieval_status": {"enum": ["complete", "partial", "failed"]},
          "failure_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "source_url", "relative_path", "media_type", "bytes", "sha256"],
              "properties": {
                "kind": {"enum": ["pdf", "jats_xml"]},
                "source_url": {"type": "string", "format": "uri"},
                "relative_path": {"type": "string", "minLength": 1},
                "media_type": {"type": "string", "minLength": 1},
                "bytes": {"type": "integer", "minimum": 1},
                "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
              }
            }
          },
          "parser_metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pdf_pages", "native_text_characters", "pages_without_native_text", "image_blocks", "rotated_pages", "jats_characters", "jats_sections", "jats_tables", "jats_figures", "jats_references"],
            "properties": {
              "pdf_pages": {"type": "integer", "minimum": 0},
              "native_text_characters": {"type": "integer", "minimum": 0},
              "pages_without_native_text": {"type": "integer", "minimum": 0},
              "image_blocks": {"type": "integer", "minimum": 0},
              "rotated_pages": {"type": "integer", "minimum": 0},
              "jats_characters": {"type": "integer", "minimum": 0},
              "jats_sections": {"type": "integer", "minimum": 0},
              "jats_tables": {"type": "integer", "minimum": 0},
              "jats_figures": {"type": "integer", "minimum": 0},
              "jats_references": {"type": "integer", "minimum": 0}
            }
          },
          "label_status": {"const": "source_document_only_not_gold"}
        }
      }
    }
  }
}
