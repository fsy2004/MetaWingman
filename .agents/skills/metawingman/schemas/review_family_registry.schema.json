{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/review_family_registry.schema.json",
  "title": "MetaWingman provisional published-review family registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generated_at_utc", "source_corpus", "algorithm",
    "summary", "families", "candidate_edges"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "source_corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "records"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "records": {"type": "integer", "minimum": 0}
      }
    },
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "version", "minimum_shared_tokens", "general_jaccard",
        "same_first_author_jaccard", "maximum_year_gap", "common_token_cap",
        "automatic_confirmation", "split_policy"
      ],
      "properties": {
        "name": {"const": "conservative_title_family_candidates"},
        "version": {"const": "1.0"},
        "minimum_shared_tokens": {"type": "integer", "minimum": 1},
        "general_jaccard": {"type": "number", "minimum": 0, "maximum": 1},
        "same_first_author_jaccard": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_year_gap": {"type": "integer", "minimum": 0},
        "common_token_cap": {"type": "integer", "minimum": 2},
        "automatic_confirmation": {"const": false},
        "split_policy": {"const": "family_hash_80_10_10_suggestion_only"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records", "families", "provisional_singletons", "candidate_families",
        "blocked_integrity_families", "excluded_non_reference_families",
        "candidate_edges", "held_out_ready_families"
      ],
      "properties": {
        "records": {"type": "integer", "minimum": 0},
        "families": {"type": "integer", "minimum": 0},
        "provisional_singletons": {"type": "integer", "minimum": 0},
        "candidate_families": {"type": "integer", "minimum": 0},
        "blocked_integrity_families": {"type": "integer", "minimum": 0},
        "excluded_non_reference_families": {"type": "integer", "minimum": 0},
        "candidate_edges": {"type": "integer", "minimum": 0},
        "held_out_ready_families": {"const": 0}
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family_id", "record_ids", "status", "suggested_split", "split_status"
        ],
        "properties": {
          "family_id": {"type": "string", "pattern": "^family:[a-f0-9]{16}$"},
          "record_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^epmc:"}
          },
          "status": {
            "enum": [
              "provisional_singleton", "candidate_requires_audit",
              "blocked_integrity", "excluded_non_reference"
            ]
          },
          "suggested_split": {"enum": ["train", "development", "test", "not_applicable"]},
          "split_status": {"const": "blocked_pending_family_audit"}
        }
      }
    },
    "candidate_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_id", "left_record_id", "right_record_id", "rule",
          "title_jaccard", "shared_title_tokens", "year_gap", "same_first_author",
          "status"
        ],
        "properties": {
          "edge_id": {"type": "string", "pattern": "^edge:[a-f0-9]{16}$"},
          "left_record_id": {"type": "string", "pattern": "^epmc:"},
          "right_record_id": {"type": "string", "pattern": "^epmc:"},
          "rule": {"enum": ["exact_normalized_title", "high_title_overlap", "author_supported_overlap"]},
          "title_jaccard": {"type": "number", "minimum": 0, "maximum": 1},
          "shared_title_tokens": {"type": "integer", "minimum": 0},
          "year_gap": {"type": "integer", "minimum": 0},
          "same_first_author": {"type": "boolean"},
          "status": {"const": "requires_audit"}
        }
      }
    }
  }
}
