{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/poolability_matrix.schema.json",
  "title": "MetaWingman estimand alignment and poolability matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "matrix_id", "synthesis_id", "target_estimand", "results",
    "proposal", "opposition", "judge_recommendation", "status", "final_decision",
    "human_signature", "created_at_utc", "updated_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "matrix_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "synthesis_id": {"type": "string", "minLength": 1},
    "target_estimand": {"$ref": "#/$defs/estimand"},
    "results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["result_id", "study_id", "estimand", "alignment", "recommendation", "reason_codes", "anchor_ids"],
        "properties": {
          "result_id": {"type": "string", "minLength": 1},
          "study_id": {"type": "string", "minLength": 1},
          "estimand": {"$ref": "#/$defs/estimand"},
          "alignment": {
            "type": "array", "minItems": 7,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["dimension", "status", "target_value", "result_value", "rationale", "anchor_ids"],
              "properties": {
                "dimension": {"enum": ["population", "contrast", "outcome", "time_horizon", "effect_measure", "analysis_unit", "conditioning_set"]},
                "status": {"enum": ["exact", "compatible", "unclear", "incompatible"]},
                "target_value": {}, "result_value": {},
                "rationale": {"type": "string", "minLength": 1},
                "anchor_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
              }
            }
          },
          "recommendation": {"enum": ["include", "exclude", "abstain"]},
          "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "anchor_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "proposal": {"$ref": "#/$defs/judgment"},
    "opposition": {"$ref": "#/$defs/judgment"},
    "judge_recommendation": {"$ref": "#/$defs/judgment"},
    "status": {"enum": ["draft", "ready_for_adjudication", "final", "superseded"]},
    "final_decision": {"type": ["string", "null"]},
    "human_signature": {"$ref": "#/$defs/signature"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "updated_at_utc": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "final"}}},
      "then": {
        "properties": {
          "final_decision": {"type": "string", "minLength": 1},
          "human_signature": {
            "properties": {
              "status": {"const": "approved"},
              "signed_by": {"type": "string", "minLength": 1},
              "signed_at_utc": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "estimand": {
      "type": "object", "additionalProperties": false,
      "required": ["population", "contrast", "outcome", "time_horizon", "effect_measure", "analysis_unit", "conditioning_set"],
      "properties": {
        "population": {"type": ["string", "null"]},
        "contrast": {"type": ["string", "null"]},
        "outcome": {"type": ["string", "null"]},
        "time_horizon": {"type": ["string", "null"]},
        "effect_measure": {"type": ["string", "null"]},
        "analysis_unit": {"type": ["string", "null"]},
        "conditioning_set": {"type": ["array", "null"], "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "judgment": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_id", "judgment", "reason_codes", "rationale", "abstained"],
      "properties": {
        "actor_id": {"type": "string"}, "judgment": {"type": "string"},
        "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "rationale": {"type": "string"}, "abstained": {"type": "boolean"}
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "signed_by", "signed_at_utc", "notes"],
      "properties": {
        "status": {"enum": ["pending", "approved", "rejected"]},
        "signed_by": {"type": "string"},
        "signed_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": "string"}
      }
    }
  }
}
