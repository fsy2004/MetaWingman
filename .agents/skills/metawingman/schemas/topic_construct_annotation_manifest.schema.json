{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/topic_construct_annotation_manifest.schema.json",
  "title": "Target-independent explicit MeSH to topic-domain annotation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_id", "vocabulary", "vocabulary_version", "source_url",
    "target_reference_derived", "case_specific_target_terms_prohibited", "domains"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "vocabulary": {"const": "NLM Medical Subject Headings"},
    "vocabulary_version": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "target_reference_derived": {"const": false},
    "case_specific_target_terms_prohibited": {"const": true},
    "domains": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["domain_id", "mesh_descriptor_terms"],
        "properties": {
          "domain_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "mesh_descriptor_terms": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
