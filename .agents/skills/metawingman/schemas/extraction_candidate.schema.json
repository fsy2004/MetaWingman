{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/extraction_candidate.schema.json",
  "title": "MetaWingman extraction candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate_id", "document_id", "report_id", "study_id", "result_id",
    "field", "value", "unit", "anchor_ids", "channel", "created_by", "confidence",
    "derivation", "status", "verification", "created_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "document_id": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "minLength": 1},
    "study_id": {"type": ["string", "null"]},
    "result_id": {"type": ["string", "null"]},
    "field": {"type": "string", "minLength": 1},
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "normalized", "data_type"],
      "properties": {
        "raw": {},
        "normalized": {},
        "data_type": {"enum": ["string", "number", "integer", "boolean", "date", "code", "array", "object", "null"]}
      }
    },
    "unit": {"type": ["string", "null"]},
    "anchor_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "channel": {"enum": ["native_text", "ocr", "layout", "table", "vision", "registry", "manual", "derived"]},
    "created_by": {"$ref": "#/$defs/actor"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "formula_or_rule", "input_candidate_ids", "tool", "tool_version"],
      "properties": {
        "method": {"enum": ["direct", "normalized", "calculated", "imputed", "converted"]},
        "formula_or_rule": {"type": "string"},
        "input_candidate_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "tool": {"type": "string"},
        "tool_version": {"type": "string"}
      }
    },
    "status": {"enum": ["candidate", "accepted", "rejected", "conflict", "superseded"]},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "status", "verified_by", "independently_derived", "verified_at_utc", "discrepancy"],
      "properties": {
        "method": {"enum": ["none", "source_recheck", "independent_extraction", "deterministic_recalculation", "human_adjudication"]},
        "status": {"enum": ["not_started", "pending", "passed", "failed"]},
        "verified_by": {"type": "string"},
        "independently_derived": {"type": "boolean"},
        "verified_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "discrepancy": {"type": "string"}
      }
    },
    "created_at_utc": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "accepted"}}},
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "status": {"const": "passed"},
              "verified_by": {"type": "string", "minLength": 1},
              "verified_at_utc": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "version"],
      "properties": {
        "type": {"enum": ["human", "model", "tool"]},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string"}
      }
    }
  }
}
