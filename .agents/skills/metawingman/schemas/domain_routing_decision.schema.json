{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metawingman.local/schemas/domain_routing_decision.schema.json",
  "title": "MetaWingman biomedical domain routing decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "context_id", "task_type", "risk_class", "candidate_pack_ids", "selected_pack_ids", "status", "confidence", "evidence", "reason_codes", "fallback", "created_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "decision_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
    "context_id": {"type": "string", "minLength": 1},
    "task_type": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "risk_class": {"enum": ["low", "moderate", "high", "critical"]},
    "candidate_pack_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "selected_pack_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "status": {"enum": ["selected", "fallback", "abstained"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pack_id", "version", "content_sha256", "validation_level"],
        "properties": {
          "pack_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "validation_level": {"enum": ["contract_only", "fixture_tested", "retrospectively_tested", "externally_validated"]}
        }
      }
    },
    "reason_codes": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "uniqueItems": true},
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "pack_id"],
      "properties": {
        "action": {"enum": ["none", "use_foundation", "abstain"]},
        "pack_id": {"type": ["string", "null"]}
      }
    },
    "created_at_utc": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "selected"}}, "required": ["status"]},
      "then": {
        "properties": {
          "selected_pack_ids": {"minItems": 1},
          "fallback": {"properties": {"action": {"const": "none"}, "pack_id": {"const": null}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "abstained"}}, "required": ["status"]},
      "then": {
        "properties": {
          "selected_pack_ids": {"maxItems": 0},
          "fallback": {"properties": {"action": {"const": "abstain"}}}
        }
      }
    }
  ]
}
